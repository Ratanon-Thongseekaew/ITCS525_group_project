# Docker Compose: MySQL local development
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=textile_track
MYSQL_USER=textile_app
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3307

# Containerized application ports exposed only on the local machine.
FRONTEND_PORT=5173
BACKEND_PORT=8000

# The Compose stack resets application rows and loads demo data before the API starts.
# Set this to false to preserve existing database contents.
SEED_DEMO_DATA=true
# Password used by every demo account when automatic seeding is enabled.
DEMO_PASSWORD=TextileDemo2026!

# Optional full SQLAlchemy URL. When set, this overrides the MYSQL_* values.
# DATABASE_URL=mysql+pymysql://textile_app:password@127.0.0.1:3307/textile_track

# Authentication. JWT_SECRET must be at least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-long-random-secret-value
# Optional: access token lifetime in minutes (default 60).
# ACCESS_TOKEN_MINUTES=60

# Uploaded files such as handoff scale photos. Optional: change where they are stored.
# UPLOAD_DIR=backend/uploads
