# Docker Compose: MySQL local development
MYSQL_HOST=127.0.0.1
MYSQL_DATABASE=textile_track
MYSQL_USER=textile_app
MYSQL_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PORT=3307

# Optional full SQLAlchemy URL. When set, this overrides the MYSQL_* values.
# DATABASE_URL=mysql+pymysql://textile_app:password@127.0.0.1:3307/textile_track
