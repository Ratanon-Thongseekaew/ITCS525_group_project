{
  "name": "react-fastapi-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "python -m uvicorn app.main:app --reload --app-dir backend",
    "app:build": "docker compose build frontend backend",
    "app:up": "docker compose up --build -d",
    "app:down": "docker compose down",
    "app:logs": "docker compose logs -f frontend backend",
    "app:status": "docker compose ps",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:status": "docker compose ps mysql",
    "db:migrate": "node scripts/run-alembic.mjs upgrade head",
    "db:rollback": "node scripts/run-alembic.mjs downgrade -1",
    "db:revision": "node scripts/run-alembic.mjs revision --autogenerate",
    "db:check": "node scripts/run-alembic.mjs check",
    "guardrails": "node scripts/check-project-guardrails.mjs",
    "test:guardrails": "node --test scripts/check-project-guardrails.test.mjs",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace frontend && python -m pytest backend",
    "test:backend": "node scripts/run-pytest.mjs",
    "lint": "npm run lint --workspace frontend && node scripts/run-ruff.mjs check backend",
    "format": "prettier --write \"**/*.{js,cjs,mjs,jsx,ts,tsx,json,css,md,yml,yaml}\" && node scripts/run-ruff.mjs format backend",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,jsx,ts,tsx,json,css,md,yml,yaml}\" && node scripts/run-ruff.mjs format --check backend",
    "commit": "npm run guardrails && npm run test:guardrails && lint-staged && npm run test:backend && cross-env ALLOW_NPM_COMMIT=1 SKIP_LINT_STAGED=1 cz",
    "prepare": "husky"
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "cz-customizable": "5.5.0",
    "gitmojis": "^3.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.62.0"
  },
  "overrides": {
    "word-wrap": "^1.2.5"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "./cz.config.cjs"
    }
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --config frontend/eslint.config.js --fix --max-warnings=0",
      "prettier --write"
    ],
    "frontend/**/*.{css,html}": "prettier --write",
    "backend/**/*.py": [
      "node scripts/run-ruff.mjs check --fix",
      "node scripts/run-ruff.mjs format"
    ],
    "*.{cjs,mjs}": "prettier --write",
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
