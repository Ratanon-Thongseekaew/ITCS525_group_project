{
  "name": "react-fastapi-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,green \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "python -m uvicorn app.main:app --reload --app-dir backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace frontend && python -m pytest backend",
    "lint": "npm run lint --workspace frontend && node scripts/run-ruff.mjs check backend",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\" && node scripts/run-ruff.mjs format backend",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md,yml,yaml}\" && node scripts/run-ruff.mjs format --check backend",
    "commit": "node scripts/gitmoji-commit.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gitmojis": "^3.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "lucide-react": "^1.62.0"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --config frontend/eslint.config.js --fix --max-warnings=0",
      "prettier --write"
    ],
    "frontend/**/*.{css,html}": "prettier --write",
    "backend/**/*.py": [
      "node scripts/run-ruff.mjs check --fix",
      "node scripts/run-ruff.mjs format"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
